<Project>

  <!-- Central Package Management: every PackageReference version in the solution is pinned
       here so shared dependencies (e.g. Avalonia) cannot drift between projects. Projects
       reference packages WITHOUT a Version attribute (<PackageReference Include="Foo" />);
       the version comes from the matching <PackageVersion> below.

       The full v1 dependency set is declared up front (FEATURE-3E11 plan, "Central package
       versions"); entries the later phases consume are already pinned here, unused for now. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Core library. No netstandard2.0 target, so the System.Buffers / PolySharp support pair
       from the house library template is deliberately absent. -->
  <ItemGroup>
    <!-- AES-256-GCM + Argon2id primitives for the EBK1 container (PHASE04). -->
    <PackageVersion Include="Enigma.Core" Version="1.1.0" />
    <!-- Zstandard compression (managed port); Gzip comes from the BCL (PHASE03). -->
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <!-- Glob exclusion patterns applied during the input scan (PHASE02). -->
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.10" />
    <!-- DI + logging seams only: the core takes abstractions, never a container or a sink. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <!-- Desktop (Avalonia) — this is a version-coupled ecosystem: bump Avalonia and the
       Fluent/theme/font packages TOGETHER, never one package at a time. Mixing versions within
       the set breaks the build, so the whole group is held back until it moves as a unit. -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <!-- The house control library: its Fluent theme, ContentDialog / Overlay / InfoBar hosts, the
         picker services, the SettingsCard family and the typed editors (FEATURE-17FE). It pins
         Avalonia 12.1.1 itself, so it belongs to the coupled set above and moves with it. It also
         brings Avalonia.Themes.Fluent, CommunityToolkit.Mvvm and Enigma.Core transitively; those
         stay pinned above so the versions are documented here rather than inherited. Its own
         Enigma.Core dependency is 1.0.0 and loses to the 1.1.0 pinned in the Core group. -->
    <PackageVersion Include="Enigma.Avalonia.Desktop" Version="1.0.0" />
    <!-- Icons: every IconData slot in the library above is a Geometry? that draws nothing when left
         null, so the restyle needs a glyph set. Enigma.Icons.Avalonia would pull the other two
         transitively; all three are pinned so a bump is a visible, deliberate edit. -->
    <PackageVersion Include="Enigma.Icons" Version="1.0.0" />
    <PackageVersion Include="Enigma.Icons.Phosphor" Version="1.0.0" />
    <PackageVersion Include="Enigma.Icons.Avalonia" Version="1.0.0" />
  </ItemGroup>

  <!-- Tests (MTP-native: xunit.v3 only). No Microsoft.NET.Test.Sdk. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- Concrete ServiceCollection for the DI-registration tests (the core only takes abstractions). -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>

</Project>
