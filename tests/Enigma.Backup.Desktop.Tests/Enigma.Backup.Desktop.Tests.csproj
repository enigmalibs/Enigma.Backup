<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mirrors the single TFM of the app under test. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Enigma.Backup.Desktop.Tests</RootNamespace>
    <AssemblyName>Enigma.Backup.Desktop.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- View-model tests only: no UI automation, so no Avalonia headless harness is needed. -->
    <ProjectReference Include="../../src/Enigma.Backup.Desktop/Enigma.Backup.Desktop.csproj" />
  </ItemGroup>

</Project>
