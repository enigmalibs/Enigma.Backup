<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mirrors the single TFM of the library under test. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Enigma.Backup.Core.Tests</RootNamespace>
    <AssemblyName>Enigma.Backup.Core.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Concrete container for the DI-registration tests; the library itself only takes abstractions. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Lets TestSupport/Ebk1Writer build an EBK1 container from the spec rather than from the code
         under test, so the format is checked against an independent implementation of it. -->
    <PackageReference Include="Enigma.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.Backup.Core/Enigma.Backup.Core.csproj" />
  </ItemGroup>

</Project>
