<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Enigma.Backup.Desktop.App"
             RequestedThemeVariant="Default">

    <!-- FluentTheme stays: Enigma.Avalonia.Desktop themes only the controls it ships (plus TextBox
         and ComboBox, by overriding FluentTheme's own brush keys), so dropping it would leave every
         other framework control — including those nested inside the library's templates — untemplated. -->
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The library's theme has a ResourceDictionary root, so it is merged here as a
                     ResourceInclude; a StyleInclude fails the build with AVLN2000. Anything of ours
                     that overrides an Enigma* key must be merged AFTER this line, or the last
                     dictionary wins and our override is silently ignored. -->
                <ResourceInclude Source="avares://Enigma.Avalonia.Desktop/Themes/Fluent.axaml" />

                <!-- The run card's own control theme. It reads the library's Enigma* brushes, so it is
                     merged after them; the overlay it sits on is the library's, the card is ours. -->
                <ResourceInclude Source="avares://Enigma.Backup.Desktop/Views/ProgressOverlayCard.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
