<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Enigma.Backup.Desktop.ViewModels"
             x:Class="Enigma.Backup.Desktop.Views.AboutDialog"
             x:DataType="vm:AboutDialogViewModel"
             Width="380"
             Focusable="True">

  <!-- Every Enigma app's About view (Enigma.GitClient's, itself Enigma.MarkdownEditor's), at the same
       size and in the same style: change it there and here together, or not at all. -->

  <!-- Enter closes it, as Escape does: the dialog asks nothing, so there is nothing else either key
       could mean here. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBlock.productName">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.version">
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>
    <!-- The build line is quieter than the version: it identifies the build for a bug report, and
         nobody reads it otherwise. -->
    <Style Selector=":is(TextBlock).build">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.copyright">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14">

    <!-- The PNG rather than enigma-backup.ico: which frame Skia picks out of an icon is unspecified, and
         the 256-pixel one is the only frame worth showing at this size. -->
    <Image Source="/Assets/enigma-backup.png"
           Width="96"
           Height="96"
           HorizontalAlignment="Center" />

    <StackPanel Spacing="3">
      <TextBlock Classes="productName" Text="{Binding DisplayName}" />

      <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
        <TextBlock Classes="version" Text="Version" />
        <TextBlock Classes="version" Text="{Binding Version}" />
      </StackPanel>

      <!-- Absent, not blank, when the build recorded no revision. -->
      <StackPanel x:Name="BuildLine"
                  Orientation="Horizontal"
                  Spacing="5"
                  HorizontalAlignment="Center"
                  IsVisible="{Binding HasBuildSha}">
        <TextBlock Classes="build" Text="Build" />
        <!-- Selectable so it can be copied straight into a bug report; the label beside it is not, so
             what lands in the clipboard is the revision alone. -->
        <SelectableTextBlock x:Name="BuildSha" Classes="build" Text="{Binding BuildSha}" />
      </StackPanel>
    </StackPanel>

    <TextBlock x:Name="Copyright"
               Classes="copyright"
               TextWrapping="Wrap"
               IsVisible="{Binding HasCopyright}"
               Text="{Binding Copyright}" />

  </StackPanel>
</UserControl>
