<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Enigma.Backup.Desktop.ViewModels"
             x:Class="Enigma.Backup.Desktop.Views.PasswordDialog"
             x:DataType="vm:PasswordDialogViewModel">

  <!-- The dialog's own Primary button submits; ContentDialog handles Escape but nothing else, so
       Enter is bound here. The command's CanExecute keeps it inert until the password is valid. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding AcceptCommand}" />
  </UserControl.KeyBindings>

  <StackPanel Spacing="12">

    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" />

    <TextBox x:Name="PasswordInput"
             Text="{Binding Password}"
             PasswordChar="•"
             PlaceholderText="Password" />

    <TextBox Text="{Binding Confirmation}"
             PasswordChar="•"
             PlaceholderText="Repeat the password"
             IsVisible="{Binding RequiresConfirmation}" />

    <TextBlock Text="{Binding ValidationMessage}"
               Foreground="{DynamicResource EnigmaErrorBrush}"
               TextWrapping="Wrap"
               IsVisible="{Binding ValidationMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

  </StackPanel>

</UserControl>
