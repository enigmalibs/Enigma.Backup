<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Enigma.Backup.Desktop.ViewModels"
        x:Class="Enigma.Backup.Desktop.Views.PasswordDialog"
        x:DataType="vm:PasswordDialogViewModel"
        Title="{Binding Title}"
        Icon="/Assets/enigma-backup.ico"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="12">

    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" />

    <TextBox x:Name="PasswordInput"
             Text="{Binding Password}"
             PasswordChar="•"
             PlaceholderText="Password" />

    <TextBox Text="{Binding Confirmation}"
             PasswordChar="•"
             PlaceholderText="Repeat the password"
             IsVisible="{Binding RequiresConfirmation}" />

    <TextBlock Text="{Binding ValidationMessage}"
               Foreground="{DynamicResource AppDangerBrush}"
               TextWrapping="Wrap"
               IsVisible="{Binding ValidationMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="90" />
      <Button Content="OK" Command="{Binding AcceptCommand}" IsDefault="True" Classes="accent" MinWidth="90" />
    </StackPanel>

  </StackPanel>

</Window>
