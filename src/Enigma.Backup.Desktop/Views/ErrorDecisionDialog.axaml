<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Enigma.Backup.Desktop.ViewModels"
             x:Class="Enigma.Backup.Desktop.Views.ErrorDecisionDialog"
             x:DataType="vm:ErrorDecisionDialogViewModel"
             Focusable="True">

  <!-- Enter skips, as the window's default button used to. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding SkipCommand}" />
  </UserControl.KeyBindings>

  <StackPanel Spacing="14">

    <SelectableTextBlock Text="{Binding Path}" TextWrapping="Wrap" FontFamily="monospace" />

    <TextBlock Text="{Binding Message}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />

    <CheckBox Content="Use this answer for every further error in this run"
              IsChecked="{Binding ApplyToAll}" />

    <TextBlock Text="Retry always asks again, even with the box ticked — a failure that never clears would otherwise loop forever."
               TextWrapping="Wrap"
               FontSize="12"
               Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />

  </StackPanel>

</UserControl>
