<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ei="https://github.com/josueclement/Enigma.Icons"
        xmlns:vm="using:Enigma.Backup.Desktop.ViewModels"
        xmlns:contentDialog="using:Enigma.Avalonia.Desktop.Controls.ContentDialog"
        xmlns:editors="using:Enigma.Avalonia.Desktop.Controls.Editors"
        xmlns:nav="using:Enigma.Avalonia.Desktop.Controls.Navigation"
        xmlns:pages="using:Enigma.Backup.Desktop.Views.Pages"
        x:Class="Enigma.Backup.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Enigma Backup"
        Icon="/Assets/enigma-backup.ico"
        Width="1120" Height="860"
        MinWidth="820" MinHeight="600"
        Background="{DynamicResource EnigmaBackgroundBrush}"
        DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- The rail's items: the icon alone, no label under it, as in Enigma.TextEditor. The name the
         label would have shown is the tooltip and what a screen reader says. Keyed by type here, so it
         replaces the library's theme for this window's rail only. -->
    <ControlTheme x:Key="{x:Type nav:NavigationItem}" TargetType="nav:NavigationItem">
      <Setter Property="Margin" Value="1" />
      <Setter Property="ToolTip.Tip" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
      <Setter Property="Template">
        <ControlTemplate>
          <PathIcon Data="{TemplateBinding IconData}"
                    Width="20"
                    Height="20"
                    Margin="{TemplateBinding Margin}"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource EnigmaForegroundBrush}" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <!-- The page header, as Enigma.Launchpad's: an icon tile, the page's name and one sentence. -->
    <Style Selector="Grid.pageHeader">
      <Setter Property="Margin" Value="24,20,24,16" />
    </Style>
    <Style Selector="Border.pageIcon">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource EnigmaSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.pageIcon > PathIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaAccentBrush}" />
    </Style>
    <Style Selector="StackPanel.pageHeading">
      <Setter Property="Spacing" Value="2" />
      <Setter Property="Margin" Value="14,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.pageDescription">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>
    <!-- The strip at the foot of a page that holds the page's one action, always in view. -->
    <Style Selector="Border.actionBar">
      <Setter Property="Background" Value="{DynamicResource EnigmaSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="24,12" />
    </Style>

    <!-- A section's title on a page of cards, above the cards it groups. -->
    <Style Selector="TextBlock.sectionHeader">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,12,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>

    <!-- A glyph beside a label, in a button or above a section. PathIcon, not a bare Path, so the glyph
         takes the Foreground it inherits — the accent button's white, a hover state's, the theme's —
         because the markup extension supplies the geometry and never the brush. -->
    <Style Selector="StackPanel.glyphrow">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="StackPanel.glyphrow > PathIcon">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.glyphrow > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Rows of actions wrap rather than overflow: a button pushed past the edge at the window's minimum
         width is a button nobody can press. -->
    <Style Selector="WrapPanel.actions > Button">
      <Setter Property="Margin" Value="0,0,6,4" />
    </Style>

    <!-- The lists sit on their own surface inside the panel, so a long path reads as being *in* a box. -->
    <Style Selector="ListBox.framed">
      <Setter Property="Background" Value="{DynamicResource EnigmaSurfaceLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- The button inside an editor's action slot: small enough to sit within the border. -->
    <Style Selector=":is(editors|BaseEditor) Button.inline">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <!--
    A Panel z-stacks its children, so the two dialog hosts come last and draw over the app. Their order
    is deliberate: the run dialog sits *below* the question host, because a mid-run decision (an
    unreadable file, a restore conflict, a password) is raised while the run is on screen, and a
    question behind the run dialog cannot be clicked — the app would look hung. Swap these two and a
    backup that hits an unreadable file becomes unanswerable.
  -->
  <Panel>

    <DockPanel>

      <!-- The rail: the pages at the top, the app's own at the bottom. Its items are built in the
           code-behind, because they are controls and the view model names none. -->
      <nav:NavigationView x:Name="Rail" DockPanel.Dock="Left" PaneSize="44" />

      <!-- One page at a time. Each is built once and hidden rather than taken out, so a page keeps
           its state — a half-edited profile — while another one is shown. -->
      <Panel>
        <Panel IsVisible="{Binding IsBackupPage}">
          <pages:BackupPage DataContext="{Binding BackupPage}" />
        </Panel>
        <Panel IsVisible="{Binding IsVerifyRestorePage}">
          <pages:VerifyRestorePage DataContext="{Binding VerifyRestorePage}" />
        </Panel>
        <Panel IsVisible="{Binding IsProfilesPage}">
          <pages:ProfilesPage DataContext="{Binding ProfilesPage}" />
        </Panel>
        <Panel IsVisible="{Binding IsSettingsPage}">
          <pages:SettingsPage DataContext="{Binding SettingsPage}" />
        </Panel>
      </Panel>

    </DockPanel>

    <!-- The run dialog: one backup, restore or verification, from its first report to its outcome. A
         host of its own, below the question host, because a run asks its questions (an unreadable
         file, a restore conflict, a password) while it is on screen, and those must draw above it.
         Its scrim is the theme's, which differs per variant. -->
    <contentDialog:ContentDialog x:Name="HostRunDialog"
                                 OverlayBrush="{DynamicResource EnigmaOverlayBrush}"
                                 DialogMinWidth="480"
                                 DialogMaxWidth="680"
                                 DialogMaxHeight="560" />

    <!-- Every question the app asks, one at a time. The six size properties are set here because the
         service does not reset them between dialogs: the bounds have to suit the widest question
         (the restore conflict, 640px as a window) and let the tallest one scroll inside the card. -->
    <contentDialog:ContentDialog x:Name="HostDialog"
                                 DialogMinWidth="420"
                                 DialogMaxWidth="680"
                                 DialogMaxHeight="560" />

  </Panel>

</Window>
