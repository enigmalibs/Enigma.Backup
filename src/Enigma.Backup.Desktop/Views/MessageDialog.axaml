<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Enigma.Backup.Desktop.ViewModels"
             x:Class="Enigma.Backup.Desktop.Views.MessageDialog"
             x:DataType="vm:MessageDialogViewModel"
             Focusable="True">

  <!-- Enter acknowledges, or agrees to what was asked, as the default button used to. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
  </UserControl.KeyBindings>

  <!-- The title is the dialog's own; only the message is content here. MaxHeight is gone with the
       window: the dialog host bounds its own card and scrolls what does not fit. -->
  <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />

</UserControl>
