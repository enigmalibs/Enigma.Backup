<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:vm="using:Enigma.Backup.Desktop.ViewModels"
             xmlns:controls="using:Enigma.Avalonia.Desktop.Controls"
             x:Class="Enigma.Backup.Desktop.Views.SettingsDialog"
             x:DataType="vm:SettingsDialogViewModel"
             Focusable="True">

  <!-- Enter closes it, as Escape does: every choice applied the moment it was made, so there is
       nothing else either key could mean here. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>

  <StackPanel Spacing="12">

    <!-- The description is the selected theme's own sentence, so the card says what the choice means
         without a second label. -->
    <controls:SettingsCard Header="Theme"
                           Description="{Binding SelectedTheme.Description}"
                           IconData="{ei:IconGeometry Palette}">
      <ComboBox ItemsSource="{Binding ThemeOptions}"
                SelectedItem="{Binding SelectedTheme}"
                MinWidth="170">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ThemeOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </controls:SettingsCard>

    <!-- The folder rather than the file: settings.json is not much use without the profiles beside
         it, and a button that opens the place beats a path the user has to copy out by hand. -->
    <controls:SettingsCard Header="Storage"
                           Description="{Binding StorageDescription}"
                           IconData="{ei:IconGeometry FolderOpen}">
      <Button Command="{Binding OpenStorageFolderCommand}"
              MinWidth="120"
              Height="32">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{ei:IconGeometry ArrowSquareOut}"
                    Width="15"
                    Height="15"
                    VerticalAlignment="Center" />
          <TextBlock Text="Open folder" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </controls:SettingsCard>

  </StackPanel>

</UserControl>
