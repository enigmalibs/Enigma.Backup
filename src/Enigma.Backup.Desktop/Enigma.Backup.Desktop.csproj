<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Enigma.Backup.Desktop</RootNamespace>
    <AssemblyName>Enigma.Backup.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows-only: embeds the icon in the .exe. The running window's icon is set in
         MainWindow.axaml (Icon="/Assets/enigma-backup.ico"), which is what Linux uses. -->
    <ApplicationIcon>Assets/enigma-backup.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Needed for the Windows clipboard / drag-and-drop interop the UI uses (PHASE05). -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Enigma.Backup.Core\Enigma.Backup.Core.csproj" />
  </ItemGroup>

</Project>
